# Client Configuration
# Display name shown in the dashboard header and context strip.
# Defaults to "Demo Company" if not set.
NEXT_PUBLIC_CLIENT_NAME=

# VAPID keys for Web Push notifications (PWA)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourcompany.com

# Supabase Configuration
# Each client deployment points to its own Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
